[submodule "vendor/cmsis_core"]
	path = vendor/cmsis_core
	url = https://github.com/STMicroelectronics/cmsis_core.git
	shallow = true
[submodule "vendor/cmsis_device_f1"]
	path = vendor/cmsis_device_f1
	url = https://github.com/STMicroelectronics/cmsis_device_f1.git
	shallow = true
[submodule "vendor/stm32f1xx_hal_driver"]
	path = vendor/stm32f1xx_hal_driver
	url = https://github.com/STMicroelectronics/stm32f1xx_hal_driver.git
	shallow = true
